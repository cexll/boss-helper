{
  "extends": "./.wxt/tsconfig.json",
  "exclude": ["node_modules", ".output", ".run", "packages/devlog-ui/src/__tests__"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "allowArbitraryExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@": ["./src"],
      "@/*": ["./src/*"],
      "~": ["./src"],
      "~/*": ["./src/*"],
      "@@": ["."],
      "@@/*": ["./*"],
      "~~": ["."],
      "~~/*": ["./*"],
      "#build/ui": ["./node_modules/.nuxt-ui/ui"],
      "#build/ui/*": ["./node_modules/.nuxt-ui/ui/*"],
      "devlog-ui": ["./packages/devlog-ui/src"]
    }
  }
}
