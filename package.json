{
  "name": "boss-helper",
  "displayName": "BossHelper",
  "version": "0.5.0",
  "private": true,
  "description": "Boss直聘助手, 皆在减少投递简历的麻烦, 和提高投递简历的效率,技术栈使用VIte + Vue3 + element-plus",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "postinstall": "wxt prepare",
    "check": "vue-tsc --noEmit",
    "build": "run-p build:chrome build:firefox build:edge",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "run-p zip:chrome zip:firefox zip:edge",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "bun test",
    "setup": "bun install",
    "hooks:install": "git config core.hooksPath .git-hooks",
    "lint:strict": "oxlint --type-aware --config .oxlintrc.gate.json",
    "test:coverage": "bun test --coverage --coverage-dir .run/coverage --coverage-reporter=lcov",
    "check:coverage": "node scripts/coverage-gate.mjs --lcov .run/coverage/lcov.info",
    "check:crap": "node scripts/check-crap.mjs",
    "check:baseline": "node scripts/check-baseline.mjs",
    "baseline:record": "node scripts/check-baseline.mjs --record",
    "duplicate-code": "jscpd --config jscpd.json",
    "dead-code": "knip --reporter compact --no-progress",
    "build:smoke": "run-s build:chrome && node scripts/build-smoke.mjs",
    "test:guardrails": "bash scripts/test-guardrails.sh && bash .git-hooks/test-naming.sh",
    "test:gates": "node scripts/test-gates.mjs",
    "check:all": "bun run test && bun run check:baseline && bun run check:coverage && bun run build:smoke",
    "check:static": "run-s fmt:check lint:strict check",
    "change-scope": "bash scripts/change-scope.sh"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@nuxt/ui": "^4.8.0",
    "@vueuse/integrations": "^14.2.1",
    "ai": "^6.0.191",
    "codejar": "^4.3.0",
    "comctx": "^1.6.1",
    "idb": "^8.0.3",
    "mqtt": "^5.15.1",
    "partial-json": "^0.1.7",
    "serialize-error": "^13.0.1",
    "spark-md5": "^3.0.2",
    "tailwindcss": "^4.3.1",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/chrome": "^0.1.40",
    "@types/node": "^25.6.0",
    "@types/spark-md5": "^3.0.5",
    "@typescript-eslint/typescript-estree": "^8.70.0",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.2.1",
    "@wxt-dev/module-vue": "^1.0.3",
    "jscpd": "^5.3.0",
    "knip": "^6.37.0",
    "lint-staged": "^17.0.7",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.23.0",
    "proto2api": "^0.0.8",
    "protobufjs": "^8.6.3",
    "sass": "^1.99.0",
    "ts-proto": "^2.11.6",
    "typescript": "^6.0.3",
    "uid": "^2.0.2",
    "vite-plugin-tailwind-shadowdom": "^1.1.1",
    "vue-tsc": "^3.2.6",
    "wxt": "^0.20.26"
  },
  "overrides": {
    "vite": "^8.0.16"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --fix"
  }
}
